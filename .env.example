# Required
GEMINI_API_KEY=your_gemini_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
# 1-45 lowercase letters, digits, or hyphens; start and end with a letter or digit
PINECONE_INDEX_NAME=node-pdf-rag

# Optional (defaults shown; blank values are treated as unset)
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# LLM provider: 'gemini' (default) or 'openrouter'
# LLM_PROVIDER=openrouter

# OpenRouter (if LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_CHAT_MODEL=inclusionai/ling-3.0-flash
# OPENROUTER_EMBEDDING_MODEL=perplexity/pplx-embed-v1-0.6b
# EMBEDDING_DIMENSION=1024
# AGENTIC_RAG=true

# Neo4j Aura (optional, for graph RAG)
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-password
# Graph RAG tuning (optional)
# GRAPH_CONCURRENCY=8
# GRAPH_BATCH_SIZE=3
